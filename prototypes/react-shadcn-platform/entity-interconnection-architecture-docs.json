  "troubleshooting": {
    "common_issues": {
      "id_generation_conflicts": {
        "symptom": "Duplicate ID errors on entity creation",
        "cause": "Board counter out of sync with existing entities",
        "solution": "Run counter sync: UPDATE boards SET current_counter = (SELECT MAX(CAST(SUBSTR(id, LENGTH(prefix)+2) AS INTEGER)) FROM entities WHERE board_id = prefix)",
        "prevention": "Use transaction-safe counter updates"
      },
      "relationship_creation_errors": {
        "symptom": "Foreign key constraint errors",
        "cause": "Source or target entity doesn't exist",
        "solution": "Always validate entities exist before creating relationships",
        "prevention": "Use EntityManager methods instead of direct SQL"
      },
      "progress_calculation_issues": {
        "symptom": "Incorrect progress percentages",
        "cause": "Circular dependencies or null estimated_hours",
        "solution": "Check for circular references, ensure estimated_hours defaults",
        "prevention": "Validate hierarchy before calculation"
      },
      "json_parsing_errors": {
        "symptom": "Metadata/attributes parsing fails",
        "cause": "Invalid JSON stored in database",
        "solution": "Validate JSON before storage, add try-catch in parsing",
        "prevention": "Use JSON.stringify for all JSON fields"
      }
    },

    "performance_optimization": {
      "slow_hierarchy_queries": {
        "issue": "Deep hierarchy queries taking too long",
        "solutions": [
          "Add index on hierarchy_path column",
          "Use LIKE queries with proper indexing",
          "Consider materialized path optimization",
          "Implement query result caching"
        ]
      },
      "relationship_query_optimization": {
        "issue": "Relationship queries with many joins",
        "solutions": [
          "Add compound indexes on (source_entity_id, relationship_type)",
          "Use query result pagination",
          "Implement relationship caching",
          "Consider denormalized relationship summaries"
        ]
      }
    },

    "data_integrity": {
      "orphaned_entities": {
        "detection": "SELECT * FROM entities WHERE parent_id NOT IN (SELECT id FROM entities)",
        "resolution": "Either fix parent_id or set to NULL for root entities"
      },
      "dangling_relationships": {
        "detection": "SELECT * FROM entity_relationships WHERE source_entity_id NOT IN (SELECT id FROM entities) OR target_entity_id NOT IN (SELECT id FROM entities)",
        "resolution": "Delete invalid relationships or create missing entities"
      },
      "counter_sync_issues": {
        "detection": "Compare board counters with actual max IDs",
        "resolution": "Sync counters using MAX queries on existing entities"
      }
    }
  },

