  "version": "1.0.0",
  "lastUpdated": "2025-01-01T00:00:00Z",
  "type": "technical_documentation",
  "categories": ["architecture", "database", "entity_management", "graphql"],
  
  "overview": {
    "description": "Comprehensive entity management system with hierarchical relationships, board-based ID generation, and real-time progress tracking",
    "purpose": "Unified entity and relationship management replacing multiple separate tables with a single, flexible architecture",
    "scope": "Core entity operations, relationship management, progress calculation, and GraphQL API integration",
    "implementation_status": "completed",
    "test_coverage": "comprehensive"
  },

  "architecture": {
    "core_components": [
      {
        "name": "EntityManager",
        "file": "src/lib/database/entity-manager.cjs",
        "purpose": "Core entity CRUD operations and business logic",
        "key_features": [
          "JIRA-style board-based ID generation",
          "Hierarchical entity management",
          "Relationship creation and management",
          "Real progress calculation from child entities",
          "Advanced search and filtering"
        ]
      },
      {
        "name": "Database Schema",
        "file": "src/lib/database/schema.sql",
        "purpose": "SQLite database structure for entities and relationships",
        "tables": [
          "entities - Unified entity storage with hierarchy support",
          "entity_relationships - Typed connections between entities",
          "boards - Board configuration for ID generation",
          "working_context - Current user focus tracking"
        ]
      },
      {
        "name": "GraphQL Integration",
        "file": "scripts/graphql-server.cjs",
        "purpose": "API layer for entity operations",
        "operations": "25+ queries and mutations for complete entity management"
      }
    ],

    "data_flow": {
      "entity_creation": [
        "1. Determine board prefix from entity type",
        "2. Generate unique JIRA-style ID (e.g., TASK-123)",
        "3. Calculate hierarchy information from parent",
        "4. Insert entity with metadata and attributes",
        "5. Auto-create parent-child relationship if applicable"
      ],
      "relationship_management": [
        "1. Validate source and target entities exist",
        "2. Generate unique relationship ID",
        "3. Create typed relationship with strength and impact scores",
        "4. Support bidirectional relationships",
        "5. Track auto-generated vs manual relationships"
      ],
      "progress_calculation": [
        "1. Check if entity has children",
        "2. If no children, return current progress",
        "3. If children exist, calculate weighted average",
        "4. Use estimated hours as weight factor",
        "5. Recursively calculate child progress",
        "6. Update parent progress in database"
      ]
    }
  },

  "api_reference": {
    "entityManager_methods": {
      "core_operations": {
        "generateEntityId": {
          "signature": "async generateEntityId(boardPrefix, entityType = null)",
          "purpose": "Generate unique JIRA-style entity ID",
          "parameters": {
            "boardPrefix": "Board prefix (TASK, PROJ, ISSUE, etc.)",
            "entityType": "Optional entity type override"
          },
          "returns": "Unique entity ID (e.g., TASK-123)",
          "example": "await entityManager.generateEntityId('TASK', 'task')"
        },
        "createEntity": {
          "signature": "async createEntity(options)",
          "purpose": "Create new entity with full hierarchy support",
          "parameters": {
            "entityType": "Type of entity (task, project, phase, etc.)",
            "title": "Entity title",
            "description": "Optional description",
            "parentId": "Optional parent entity ID",
            "boardPrefix": "Optional board prefix override",
            "status": "Entity status (pending, in_progress, completed, blocked)",
            "priority": "Priority level (low, medium, high, critical)",
            "assignee": "Optional assignee",
            "estimatedHours": "Optional time estimate",
            "metadata": "Custom metadata object",
            "attributes": "Custom attributes object",
            "labels": "Array of labels",
            "dependencies": "Array of dependency IDs"
          },
          "returns": "Created entity with generated ID",
          "example": "await entityManager.createEntity({ entityType: 'task', title: 'Example Task', status: 'pending' })"
        },
        "getEntity": {
          "signature": "getEntity(entityId)",
          "purpose": "Retrieve entity by ID with parsed JSON fields",
          "parameters": {
            "entityId": "Unique entity ID"
          },
          "returns": "Entity object with parsed metadata, attributes, labels, dependencies",
          "example": "const entity = entityManager.getEntity('TASK-123')"
        },
        "updateEntityStatus": {
          "signature": "updateEntityStatus(entityId, status, options = {})",
          "purpose": "Update entity status with automatic progress recalculation",
          "parameters": {
            "entityId": "Entity ID to update",
            "status": "New status",
            "options": "Additional fields (progress, assignee, actualHours)"
          },
          "returns": "Boolean success status",
          "side_effects": "Automatically recalculates parent progress",
          "example": "entityManager.updateEntityStatus('TASK-123', 'completed')"
        }
      },
      "hierarchy_operations": {
        "getEntityChildren": {
          "signature": "getEntityChildren(entityId)",
          "purpose": "Get direct child entities",
          "returns": "Array of child entities",
          "example": "const children = entityManager.getEntityChildren('PROJ-1')"
        },
        "getEntityHierarchy": {
          "signature": "getEntityHierarchy(entityId)",
          "purpose": "Get all descendant entities",
          "returns": "Array of all descendants ordered by level",
          "example": "const hierarchy = entityManager.getEntityHierarchy('PROJ-1')"
        },
        "calculateEntityProgress": {
          "signature": "calculateEntityProgress(entityId)",
          "purpose": "Calculate real progress from child completion",
          "algorithm": "Weighted average using estimated hours as weights",
          "side_effects": "Updates entity progress in database",
          "returns": "Calculated progress percentage",
          "example": "const progress = entityManager.calculateEntityProgress('PROJ-1')"
        }
      },
      "relationship_operations": {
        "createRelationship": {
          "signature": "async createRelationship(sourceEntityId, targetEntityId, relationshipType, options = {})",
          "purpose": "Create typed relationship between entities",
          "parameters": {
            "sourceEntityId": "Source entity ID",
            "targetEntityId": "Target entity ID",
            "relationshipType": "Type of relationship (depends_on, blocks, tests, implements, etc.)",
            "options": {
              "strength": "Relationship strength (0.0-1.0)",
              "impactScore": "Impact score (0.0-1.0)",
              "isBidirectional": "Whether relationship works both ways",
              "notes": "Optional notes",
              "createdBy": "Creator identifier"
            }
          },
          "returns": "Generated relationship ID",
          "example": "await entityManager.createRelationship('TASK-1', 'TASK-2', 'depends_on', { strength: 0.8 })"
        },
        "getEntityRelationships": {
          "signature": "getEntityRelationships(entityId, options = {})",
          "purpose": "Get entity relationships with filtering",
          "parameters": {
            "entityId": "Entity ID",
            "options": {
              "direction": "both, incoming, or outgoing",
              "relationshipType": "Filter by relationship type",
              "isActive": "Filter by active status"
            }
          },
          "returns": "Array of relationships with entity details",
          "example": "const relationships = entityManager.getEntityRelationships('TASK-1', { direction: 'outgoing' })"
        }
      },
      "utility_operations": {
        "searchEntities": {
          "signature": "searchEntities(searchOptions = {})",
          "purpose": "Advanced entity search with multiple filters",
          "parameters": {
            "text": "Text search in title/description",
            "entityType": "Filter by entity type",
            "status": "Filter by status",
            "boardPrefix": "Filter by board",
            "assignee": "Filter by assignee",
            "priority": "Filter by priority",
            "limit": "Limit results"
          },
          "returns": "Array of matching entities",
          "example": "const results = entityManager.searchEntities({ text: 'test', status: 'in_progress', limit: 10 })"
        },
        "getBoardStats": {
          "signature": "getBoardStats(boardPrefix)",
          "purpose": "Get comprehensive board statistics",
          "returns": "Statistics object with counts, progress, and hours",
          "example": "const stats = entityManager.getBoardStats('TASK')"
        }
      }
    },

    "graphql_operations": {
      "queries": {
        "getEntity": "getEntity(id: String!): Entity",
        "getEntities": "getEntities(filter: EntityFilter): [Entity!]!",
        "getEntityHierarchy": "getEntityHierarchy(id: String!): [Entity!]!",
        "getEntityRelationships": "getEntityRelationships(entityId: String!, options: RelationshipOptions): [EntityRelationship!]!",
        "getBoards": "getBoards: [Board!]!",
        "getBoardStats": "getBoardStats(boardPrefix: String!): BoardStats!",
        "searchEntities": "searchEntities(options: SearchOptions!): [Entity!]!",
        "getWorkingContext": "getWorkingContext(userId: String!): WorkingContext"
      },
      "mutations": {
        "createEntity": "createEntity(input: CreateEntityInput!): Entity!",
        "updateEntity": "updateEntity(id: String!, input: UpdateEntityInput!): Entity!",
        "updateEntityStatus": "updateEntityStatus(id: String!, status: EntityStatus!, options: UpdateStatusOptions): Entity!",
        "createRelationship": "createRelationship(input: CreateRelationshipInput!): EntityRelationship!",
        "deleteRelationship": "deleteRelationship(id: String!): Boolean!",
        "setWorkingContext": "setWorkingContext(userId: String!, entityId: String!, context: String): WorkingContext!"
      }
    }
  },

  "database_schema": {
    "entities_table": {
      "purpose": "Unified storage for all entity types",
      "key_fields": {
        "id": "JIRA-style unique identifier (PRIMARY KEY)",
        "entity_type": "Type classification (task, project, phase, etc.)",
        "parent_id": "Optional parent for hierarchy",
        "board_id": "Board prefix for organization",
        "title": "Display name",
        "description": "Optional detailed description",
        "status": "Current status (pending, in_progress, completed, blocked)",
        "priority": "Priority level (low, medium, high, critical)",
        "level": "Hierarchy depth (0 = root)",
        "hierarchy_path": "Full path from root (e.g., PROJ-1/PHASE-2/TASK-3)",
        "assignee": "Optional assignee identifier",
        "progress": "Progress percentage (0-100)",
        "estimated_hours": "Time estimate",
        "actual_hours": "Actual time spent",
        "start_date": "Optional start date",
        "due_date": "Optional due date",
        "completion_date": "Automatic completion timestamp",
        "metadata": "JSON custom metadata",
        "attributes": "JSON custom attributes",
        "labels": "JSON array of labels",
        "dependencies": "JSON array of dependency IDs",
        "sort_order": "Optional manual sorting",
        "created_by": "Creator identifier",
        "updated_by": "Last updater identifier",
        "created_at": "Creation timestamp",
        "updated_at": "Last update timestamp"
      },
      "indexes": [
        "idx_entities_parent_id - for hierarchy queries",
        "idx_entities_board_id - for board filtering",
        "idx_entities_status - for status filtering",
        "idx_entities_assignee - for assignee filtering"
      ]
    },

    "entity_relationships_table": {
      "purpose": "Typed connections between entities",
      "key_fields": {
        "id": "Unique relationship identifier",
        "source_entity_id": "Source entity ID",
        "target_entity_id": "Target entity ID",
        "relationship_type": "Type of relationship",
        "strength": "Relationship strength (0.0-1.0)",
        "is_auto_generated": "Whether system-generated",
        "impact_score": "Impact assessment (0.0-1.0)",
        "is_bidirectional": "Whether relationship works both ways",
        "context": "JSON context information",
        "notes": "Optional text notes",
        "tags": "JSON array of tags",
        "is_active": "Soft delete flag",
        "created_by": "Creator identifier",
        "created_at": "Creation timestamp",
        "updated_at": "Last update timestamp"
      },
      "relationship_types": [
        "parent_of - hierarchical parent relationship",
        "depends_on - dependency relationship",
        "blocks - blocking relationship",
        "tests - testing relationship",
        "implements - implementation relationship",
        "documents - documentation relationship",
        "references - reference relationship"
      ]
    },

    "boards_table": {
      "purpose": "Board configuration for ID generation",
      "key_fields": {
        "prefix": "Board prefix (PRIMARY KEY)",
        "name": "Display name",
        "description": "Board description",
        "default_entity_type": "Default entity type for this board",
        "current_counter": "Current ID counter",
        "is_active": "Whether board is active"
      },
      "default_boards": [
        "TASK - General tasks",
        "PROJ - Projects",
        "PHASE - Project phases", 
        "ISSUE - Issues and bugs",
        "SPEC - Specifications",
        "QUAL - Quality reports",
        "REV - Reviews and approvals",
        "REL - Relationships",
        "DASH - Dashboard items"
      ]
    },

    "working_context_table": {
      "purpose": "Track current user focus and context",
      "key_fields": {
        "user_id": "User identifier",
        "current_entity_id": "Currently focused entity",
        "context_type": "Type of context (focus, review, etc.)",
        "context_data": "JSON context information",
        "updated_at": "Last update timestamp"
      }
    }
  },

