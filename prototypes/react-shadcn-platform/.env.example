# Environment Variables Configuration
# Copy this file to .env.local for local development

# Server Configuration
NODE_ENV=development
PORT=5173

# GraphQL API Configuration
GRAPHQL_PORT=3004
GRAPHQL_URL=http://localhost:3004/graphql
GRAPHQL_PLAYGROUND_ENABLED=true

# Validation API Configuration  
VALIDATION_PORT=3005
VALIDATION_URL=http://localhost:3005

# Development Configuration
VITE_GRAPHQL_URL=http://localhost:3004/graphql
VITE_VALIDATION_URL=http://localhost:3005
VITE_APP_VERSION=1.0.0

# Production Configuration (for deployment)
# These will be automatically set by Vercel deployment
VITE_GRAPHQL_URL_PROD=/api/graphql
VITE_VALIDATION_URL_PROD=/api/validation
VITE_DASHBOARD_URL_PROD=/api/dashboard

# Vercel Production Environment Variables
# Set these in your Vercel dashboard > Project > Settings > Environment Variables
# VITE_GRAPHQL_URL=/api/graphql
# VITE_VALIDATION_URL=/api/validation
# VITE_DASHBOARD_URL=/api/dashboard

# Database Configuration (when implemented)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# REDIS_URL=redis://localhost:6379

# Security Configuration  
# JWT_SECRET=your-super-secret-jwt-key
# SESSION_SECRET=your-session-secret

# External Services (when implemented)
# GITHUB_TOKEN=your-github-token
# GITHUB_REPO=owner/repo-name

# Logging Configuration
LOG_LEVEL=info