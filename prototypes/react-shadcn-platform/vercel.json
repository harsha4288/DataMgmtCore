{
  "version": 2,
  "framework": "vite",
  "functions": {
    "api/graphql.js": {
      "runtime": "nodejs20.x",
      "maxDuration": 30
    },
    "api/validation.js": {
      "runtime": "nodejs20.x", 
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/graphql",
      "dest": "/api/graphql.js"
    },
    {
      "src": "/api/validation/(.*)",
      "dest": "/api/validation.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "GRAPHQL_URL": "/api/graphql",
    "VALIDATION_URL": "/api/validation"
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "devCommand": "npm run dev"
}